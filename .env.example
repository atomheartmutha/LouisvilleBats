# Louisville Bats - Road to the Bats Environment Configuration

# Server Port
PORT=3000

# Google Gemini API Key
# Get a free key from Google AI Studio: https://aistudio.google.com/
# or redeem your MLH student benefits at: https://www.mlh.com/partners/gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Vultr API Key (for automated CLI / deployment scripts)
# Retrieve from Vultr Dashboard: https://my.vultr.com/settings/#settingsapi
# Claim your $100 MLH gift code via: https://mlh.link/vultr-giftcode
VULTR_API_KEY=your_vultr_api_key_here

# Application Environment
NODE_ENV=development
